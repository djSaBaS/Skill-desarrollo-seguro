# Identifica el entorno sin activar registros de depuración.
APP_ENV=local
# Mantiene desactivada la exposición de errores y valores sensibles.
APP_DEBUG=false
# Define el host de base de datos según la instalación privada.
DB_HOST=
# Indica el puerto sin incluir ninguna contraseña.
DB_PORT=3306
# Identifica la base de datos autorizada.
DB_NAME=
# Identifica el usuario con los permisos mínimos necesarios.
DB_USER=
# Reserva la clave de base de datos para el .env real no versionado.
DB_PASSWORD=
# Reserva un secreto aleatorio de aplicación, distinto por entorno.
APP_SECRET=
# Reserva una clave de sesión distinta del secreto de aplicación.
SESSION_SIGNING_KEY=
# Reserva la clave de API privada del servicio externo si se utiliza.
SERVICE_API_KEY=
